<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AAPSBuildType</key>
	<string>$(CONFIGURATION)</string>
	<key>AAPSRole</key>
	<string>$(AAPS_ROLE)</string>
	<key>AAPSConnectIqUrlScheme</key>
	<string>$(AAPS_CIQ_URL_SCHEME)</string>
	<key>AapsAppGroupId</key>
	<string>$(AAPS_APP_GROUP_ID)</string>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>app.aaps.aimi.retention</string>
		<string>app.aaps.aimi.ml-training</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER).connectiq</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(AAPS_CIQ_URL_SCHEME)</string>
			</array>
		</dict>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>gcm-ciq</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>processing</string>
		<string>bluetooth-central</string>
		<string>audio</string>
	</array>
	<key>UIFileSharingEnabled</key>
	<true/>
</dict>
</plist>
