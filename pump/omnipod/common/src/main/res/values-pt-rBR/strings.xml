    <!-- Omnipod - Pod Activation Wizard -->
    <string name="omnipod_common_pod_activation_wizard_start_pod_activation_title">Encher Pod</string>
    <string name="omnipod_common_pod_activation_wizard_initialize_pod_title">Inicializar Pod</string>
    <string name="omnipod_common_pod_activation_wizard_attach_pod_title">Aplicar Pod</string>
    <string name="omnipod_common_pod_activation_wizard_attach_pod_text">Prepare o local de infusão. Remova a tampa da agulha e o adesivo do Pod e aplique o Pod no local de infusão.\n\nSe a cânula sobressair, por favor prima <b>Cancelar</b> e descarte o Pod.\n\nPrima <b>Seguinte</b> para inserir a cânula e iniciar a administração basal.</string>
    <string name="omnipod_common_pod_activation_wizard_attach_pod_confirm_insert_cannula_text">Quando premir <b>OK</b>, a cânula será inserida. Certifique-se de que aplicou o Pod no local de infusão.</string>
    <string name="omnipod_common_pod_activation_wizard_insert_cannula_title">Inserir Cânula</string>
    <string name="omnipod_common_pod_activation_wizard_insert_cannula_text">A tentar definir o programa basal inicial e inserir a cânula.\n\nQuando a cânula for inserida com êxito, pode premir <b>Seguinte</b>.</string>
    <string name="omnipod_common_pod_activation_wizard_pod_activated_title">Pod Ativado</string>
    <string name="omnipod_common_pod_activation_wizard_pod_activated_text">O novo Pod está agora ativo.\n\nO seu programa basal foi programado e a cânula foi inserida.\n\nPor favor, verifique se a cânula foi inserida corretamente e mude o Pod se achar que não foi.</string>

    <!-- Omnipod - Pod Deactivation Wizard -->
    <string name="omnipod_common_pod_deactivation_wizard_start_pod_deactivation_title">Desativar Pod</string>
    <string name="omnipod_common_pod_deactivation_wizard_start_pod_deactivation_text">Prima <b>Seguinte</b> para desativar o Pod.\n\n<b>Nota:</b> Isto suspenderá toda a administração de insulina e desativará o Pod.</string>
    <string name="omnipod_common_pod_deactivation_wizard_deactivating_pod_title">A Desativar o Pod</string>
    <string name="omnipod_common_pod_deactivation_wizard_deactivating_pod_text">A desativar o Pod.\n\nQuando a desativação for concluída com êxito, pode premir <b>Seguinte</b>.</string>
    <string name="omnipod_common_pod_deactivation_wizard_pod_deactivated_title">Pod Desativado</string>
    <string name="omnipod_common_pod_deactivation_wizard_pod_deactivated_text">O seu Pod foi desativado.\n\nPor favor, remova o Pod do seu corpo e recicle-o.</string>
    <string name="omnipod_common_pod_deactivation_wizard_pod_discarded_title">Pod Descartado</string>
    <string name="omnipod_common_pod_deactivation_wizard_pod_discarded_text">O estado do Pod foi descartado. A administração de insulina não foi suspensa porque o Pod não foi desativado corretamente!\n\nPor favor, remova o Pod do seu corpo e recicle-o.</string>
    <string name="omnipod_common_pod_deactivation_wizard_discard_pod_confirmation">Se descartar o Pod, deixará de conseguir comunicar com ele. Apenas deve fazer isto quando toda a comunicação com o Pod falhar persistentemente. Tem a certeza de que deseja descartar o Pod?</string>
    <string name="omnipod_common_pod_deactivation_wizard_discard_pod">Descartar Pod</string>

